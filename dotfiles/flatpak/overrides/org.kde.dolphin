devices=shm;kvm;input
filesystems=!~/.var/app;/home/redstar/Music:ro;/home/redstar/Videos:ro;/home/redstar/Pictures:ro;/home/redstar/Downloads:ro;/home/redstar/Documents:ro;/home/redstar/Desktop:ro;/mnt:ro;/run/media:ro;/media:ro;!home

[System Bus Policy]
org.freedesktop.UDisks2=none

[Session Bus Policy]
org.kde.kded5=none
org.freedesktop.Flatpak=none
org.kde.kiod6=none
org.kde.kiod5=none
org.kde.kded6=none
